"select json_build_object(\n 'accounts',(select json_agg(x) from public.accounts x),\n 'categories',(select json_agg(x) from public.categories x),\n 'payers',(select json_agg(x) from public.payers x),\n 'markets',(select json_agg(x) from public.markets x),\n 'market_schedules',(select json_agg(x) from public.market_schedules x),\n 'items',(select json_agg(x) from public.items x),\n 'suppliers',(select json_agg(x) from public.suppliers x),\n 'app_settings',(select json_agg(x) from public.app_settings x),\n 'recurring_txns',(select json_agg(x) from public.recurring_txns x),\n 'import_batches',(select json_agg(x) from (select * from public.import_batches order by created_at desc limit 20) x),\n 'market_plans',(select json_agg(x) from public.market_plans x where day >= '2026-09-01'),\n 'business_days',(select json_agg(x) from public.business_days x where day >= '2026-09-01'),\n 'transactions',(select json_agg(x) from public.transactions x where txn_date >= '2026-09-01'),\n 'daily_item_counts',(select json_agg(x) from public.daily_item_counts x where business_day_id in (select id from public.business_days where day >= '2026-09-01')),\n 'purchase_orders',(select json_agg(x) from public.purchase_orders x where order_date >= '2026-09-01'),\n 'purchase_lines',(select json_agg(x) from public.purchase_lines x where purchase_order_id in (select id from public.purchase_orders where order_date >= '2026-09-01')),\n 'inventory_adjustments',(select json_agg(x) from public.inventory_adjustments x where adj_date >= '2026-09-01'),\n 'v_monthly_summary',(select json_agg(x) from public.v_monthly_summary x where month >= '2026-01-01'),\n 'v_monthly_category',(select json_agg(x) from public.v_monthly_category x where month >= '2026-01-01'),\n 'v_daily_summary',(select json_agg(x) from public.v_daily_summary x where day >= '2026-09-01'),\n 'v_pnl_entries',(select json_agg(x) from public.v_pnl_entries x where entry_date >= '2026-09-01'),\n 'v_cost_entries',(select json_agg(x) from public.v_cost_entries x where entry_date >= '2026-09-01'),\n 'v_rent_prepaid',(select json_agg(x) from public.v_rent_prepaid x),\n 'v_advance_balances',(select json_agg(x) from public.v_advance_balances x),\n 'v_inventory',(select json_agg(x) from public.v_inventory x),\n 'v_inventory_flows',(select json_agg(x) from public.v_inventory_flows x where flow_date >= '2026-09-01'),\n 'v_fifo_costs',(select json_agg(x) from public.v_fifo_costs x),\n 'v_supplier_balances',(select json_agg(x) from public.v_supplier_balances x),\n 'v_account_balances',(select json_agg(x) from public.v_account_balances x),\n 'v_account_ledger',(select json_agg(x) from public.v_account_ledger x where txn_date >= '2026-10-01'),\n 'v_purchase_order_status',(select json_agg(x) from public.v_purchase_order_status x)\n)::text as j;\n"
